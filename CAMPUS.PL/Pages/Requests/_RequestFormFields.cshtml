@using CAMPUS.DOMAIN.Enums
@model CAMPUS.PL.Models.RequestFormPageModel

@* The fields shared by New request and Edit. The page adds the form, the card and the buttons. *@

<div class="mb-3">
    <label asp-for="Input.Title" class="form-label"></label>
    <input asp-for="Input.Title" class="form-control"
           placeholder="For example: Water leak in the north hallway" />
    <span asp-validation-for="Input.Title" class="field-error"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Input.CategoryId" class="form-label"></label>
        <select asp-for="Input.CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="" disabled selected>Choose a category</option>
        </select>
        <span asp-validation-for="Input.CategoryId" class="field-error"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Input.CampusId" class="form-label"></label>
        <select asp-for="Input.CampusId" asp-items="Model.Campuses" class="form-select">
            <option value="" disabled selected>Choose a campus</option>
        </select>
        <span asp-validation-for="Input.CampusId" class="field-error"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Input.Location" class="form-label"></label>
        <input asp-for="Input.Location" class="form-control"
               placeholder="Building, floor or room" />
        <span asp-validation-for="Input.Location" class="field-error"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Input.Priority" class="form-label"></label>
        <select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select">
        </select>
        <span asp-validation-for="Input.Priority" class="field-error"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Input.Description" class="form-label"></label>
    <textarea asp-for="Input.Description" class="form-control" rows="5"
              placeholder="What's the problem? Since when? Anything else we should know?"></textarea>
    <span asp-validation-for="Input.Description" class="field-error"></span>
</div>