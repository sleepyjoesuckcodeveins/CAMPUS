@page
@using CAMPUS.BLL.Common
@using CAMPUS.DOMAIN.Enums
@using CAMPUS.DOMAIN.Formatting
@using CAMPUS.PL.Helpers
@model CAMPUS.PL.Pages.Support.AssignedModel
@{
    ViewData["Title"] = "Assigned to me";
}

<div class="page-header">
    <div>
        <span class="eyebrow">Support</span>
        <h1 class="page-title">Assigned to me</h1>
        <p class="page-subtitle">
            @(Model.HasTeam ? $"Requests assigned to the {Model.TeamName} team." : "Requests assigned to your team.")
        </p>
    </div>
</div>

@if (!Model.HasTeam)
{
    <div class="card-c">
        <div class="empty-state">
            <i class="bi bi-people" aria-hidden="true"></i>
            <p>@Messages.NoTeam</p>
        </div>
    </div>
}
else
{
    <div class="card-c mb-3">
        <div class="card-c-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All statuses</option>
                        @foreach (var s in Enum.GetValues<RequestStatus>())
                        {
                            <option value="@s" selected="@(Model.Status == s)">@s.ToLabel()</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-campus-outline">
                        <i class="bi bi-funnel" aria-hidden="true"></i> Filter
                    </button>
                    <a asp-page="/Support/Assigned" class="btn btn-campus-link">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card-c">
        @if (Model.Requests.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <p>@Messages.AssignedEmpty</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-c">
                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Category</th>
                            <th>Campus</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th class="text-end">Created</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Requests)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Requests/Details" asp-route-id="@r.Id" class="req-title">@r.Title</a>
                                    <div class="req-meta">@r.RefCode() · @r.Location</div>
                                </td>
                                <td>@((r.Category?.Name).OrDash())</td>
                                <td>@((r.Campus?.Name).OrDash())</td>
                                <td><partial name="_PriorityBadge" model="r.Priority" /></td>
                                <td><partial name="_StatusBadge" model="r.Status" /></td>
                                <td class="text-end">@r.CreatedAt.ToTimeAgo()</td>
                                <td class="text-end">
                                    @if (r.Status == RequestStatus.Resolved)
                                    {
                                        <a asp-page="/Requests/Details" asp-route-id="@r.Id" class="btn btn-sm btn-campus-outline">View</a>
                                    }
                                    else
                                    {
                                        <a asp-page="/Support/Update" asp-route-id="@r.Id" class="btn btn-sm btn-campus-outline">
                                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Update status
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}