@page
@using CAMPUS.BLL.Common
@using CAMPUS.DOMAIN.Enums
@using CAMPUS.DOMAIN.Formatting
@using CAMPUS.PL.Helpers
@model CAMPUS.PL.Pages.Manager.AllRequestsModel
@{
    ViewData["Title"] = "All requests";
}

<div class="page-header">
    <div>
        <span class="eyebrow">Facilities</span>
        <h1 class="page-title">All requests</h1>
        <p class="page-subtitle">Every request across all CGI campuses.</p>
    </div>
</div>

<div class="card-c mb-3">
    <div class="card-c-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<RequestStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s.ToLabel()</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="campusId" class="form-label">Campus</label>
                <select id="campusId" name="campusId" class="form-select">
                    <option value="">All campuses</option>
                    @foreach (var c in Model.Campuses)
                    {
                        <option value="@c.Value" selected="@c.Selected">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-campus-outline">
                    <i class="bi bi-funnel" aria-hidden="true"></i> Filter
                </button>
                <a asp-page="/Manager/AllRequests" class="btn btn-campus-link">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card-c">
    <div class="card-c-header">
        <h2 class="card-c-title">Requests</h2>
        <p class="card-c-subtitle">@Model.Requests.Count requests</p>
    </div>

    @if (Model.Requests.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-search" aria-hidden="true"></i>
            <p>@Messages.AllRequestsEmpty</p>
            <a asp-page="/Manager/AllRequests" class="btn btn-campus-link">Clear filters</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-c">
                <thead>
                    <tr>
                        <th>Request</th>
                        <th>Category</th>
                        <th>Campus</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Assigned team</th>
                        <th class="text-end">Created</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Requests)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Requests/Details" asp-route-id="@r.Id" class="req-title">@r.Title</a>
                                <div class="req-meta">@r.RefCode() · @r.Location</div>
                            </td>
                            <td>@((r.Category?.Name).OrDash())</td>
                            <td>@((r.Campus?.Name).OrDash())</td>
                            <td><partial name="_PriorityBadge" model="r.Priority" /></td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td>@((r.AssignedTeam?.Name).OrDash())</td>
                            <td class="text-end">@r.CreatedAt.ToTimeAgo()</td>
                            <td class="text-end">
                                @if (r.Status == RequestStatus.Resolved)
                                {
                                    <a asp-page="/Requests/Details" asp-route-id="@r.Id" class="btn btn-sm btn-campus-outline">View</a>
                                }
                                else
                                {
                                    <a asp-page="/Manager/Assign" asp-route-id="@r.Id" class="btn btn-sm btn-campus-outline">
                                        <i class="bi bi-people" aria-hidden="true"></i> @(r.AssignedTeamId is null ? "Assign" : "Reassign")
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>